# Copy to .env.local (git-ignored) and fill in what you need.

# Extra hostnames the Vite dev server accepts, comma-separated.
# Example for an ngrok tunnel: VITE_ALLOWED_HOSTS=your-subdomain.ngrok-free.dev
VITE_ALLOWED_HOSTS=

# Backend API origin. Use "localhost", never 127.0.0.1 (the refresh cookie is same-site only).
# Defaults to http://localhost:8000 when empty.
VITE_API_BASE_URL=http://localhost:8000
